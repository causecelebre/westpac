# Local values only. `make env` copies this file to .env, which git ignores.

DB_HOST=localhost
DB_PORT=5432
DB_APP_PASSWORD=local-app-password
DB_OWNER_PASSWORD=local-owner-password
REDIS_HOST=localhost
REDIS_PORT=6379
APP_PORT=8080
MANAGEMENT_PORT=8081

# Read by Compose only, never by the application.
DB_SUPERUSER_PASSWORD=local-superuser-password
